PORT=5000
JWT_SECRET=change-me
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/luxe_lingerie
# For managed Postgres (e.g. Neon, Supabase, Render)
# Neon connection string example: postgresql://neondb_owner:...@.../neondb?sslmode=require

# Admin login (email must match exactly; use ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-admin-password
# ADMIN_PASSWORD_HASH=$2b$...   # bcrypt hash alternative to ADMIN_PASSWORD

# OTP email: set either SMTP_* OR EMAIL_* variables
# Use Ethereal in dev (fake inbox, preview URL in API response)
# ETHEREAL=true (enabled by default, set to false to disable)
ETHEREAL=false

# ============ EMAIL PROVIDER OPTIONS ============
# Pick ONE provider below!

# OPTION 1: GMAIL (NOT RECOMMENDED FOR PRODUCTION, OFTEN BLOCKED ON HOSTING PLATFORMS)
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# Gmail instructions:
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use that App Password as SMTP_PASS

# OPTION 2: SENDGRID (RECOMMENDED FOR PRODUCTION)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# OR use EMAIL_* prefix:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key

# OPTION 3: BREVO (FORMERLY SENDINBLUE, RECOMMENDED FOR PRODUCTION)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-brevo-smtp-key
# OR use EMAIL_* prefix:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your-brevo-login-email
# EMAIL_PASS=your-brevo-smtp-key

MAIL_FROM="Store <no-reply@example.com>"
