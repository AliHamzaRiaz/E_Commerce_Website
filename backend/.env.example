PORT=5000
JWT_SECRET=change-me
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/luxe_lingerie
# For managed Postgres (e.g., Neon, Supabase, Render)
# Neon connection string example: postgresql://neondb_owner:...@.../neondb?sslmode=require

# Admin login (email must match exactly; use ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password
# ADMIN_PASSWORD_HASH=$2b$...   # bcrypt hash alternative to ADMIN_PASSWORD

# ============ EMAIL PROVIDER: BREVO (SMTP RELAY) ============
# Get your Brevo SMTP credentials from https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="LIBBAAS <no-reply@your-domain.com>"  # Use a verified sender email

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173
